---
interface Props {
  name: string;
  url: string;
  isBig?: boolean;
}

const { name, url, isBig = false } = Astro.props;

const pokemonId = url.trim().split("/").at(-2);
---

<!-- href={`/pokemons/${name}`} -->
<!-- href={`pokemon/${pokemonId}`} -->
<a
  href={`/pokemons/${name}`}
  class:list={["rounded flex flex-col justify-center items-center p-2", { border: !isBig }]}
>
  <img
    transition:name={`${name}-image`}
    class:list={[{ "w-22 h-22": isBig, "w-16 h-16": !isBig }]}
    src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${pokemonId}.png`}
    alt=""
  />

  <span
    class:list={[
      "capitalize",
      {
        "text-4xl text-blue-300": isBig,
      },
    ]}
  >
    #{pokemonId} {name}
  </span>
</a>
